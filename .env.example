# COMPOSITOR local experiment settings. Copy to .env and fill the values you need.
# This is a planned interface: COMPOSITOR has no environment loader or running
# pipeline yet. A future implementation must document and validate each setting.
# Paths may be absolute or relative to this repository root.

# Private inputs, reviewed gold, experiment exports, and media.
COMPOSITOR_PRIVATE_ROOT=.local/private

# Generated run artifacts and diagnostics. Keep first results and later repairs
# in separate run directories beneath this root.
COMPOSITOR_OUTPUT_ROOT=.local/out

# Exact one-shot inputs. Leave unused formats blank. Pin revision and digest in
# the private run manifest; these paths alone do not establish source identity.
COMPOSITOR_CONKS_PDF=
COMPOSITOR_CONKS_MARKDOWN=
COMPOSITOR_SHEEP_PDF=
COMPOSITOR_SHEEP_MARKDOWN=

# Isolated private experiment database. Select the backend and create the
# namespace before the first real-source run; never point this at World authority.
COMPOSITOR_EXPERIMENT_DATABASE_URL=

# Optional provider credentials. Fill only for an explicitly scoped live run.
# Model, source-handling decision, call/round limits, and spend cap belong in
# that run's recorded configuration, not in this local template.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional later Buddy integration. This existing name is used by Buddy's
# internal statblock API; COMPOSITOR does not call that API yet.
DUNGEONBUDDY_INTERNAL_API_KEY=
